{
  "name": "CoolingPath",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install -e \".[dev]\"",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "CoolingPath",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
